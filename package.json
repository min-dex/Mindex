{
  "name": "mindex",
  "version": "0.1.1",
  "private": true,
  "description": "Mindex desktop shell",
  "author": "Mindex",
  "packageManager": "pnpm@11.9.0",
  "main": "electron/main.js",
  "scripts": {
    "dev:web": "python3 serve.py",
    "electron:dev": "electron .",
    "dist:clean": "node scripts/clean-electron-dist.mjs",
    "dist:prune": "node scripts/prune-electron-dist.mjs",
    "package:audit": "node scripts/audit-electron-package.mjs",
    "electron:pack": "pnpm run dist:clean && electron-builder --dir && node scripts/clear-local-quarantine.mjs",
    "electron:pack:raw": "pnpm run dist:clean && electron-builder --dir",
    "electron:dist": "pnpm run dist:clean && electron-builder && pnpm run dist:prune",
    "electron:dist:mac:arm64": "pnpm run dist:clean && electron-builder --mac dmg --arm64 && pnpm run dist:prune",
    "electron:dist:mac:x64": "pnpm run dist:clean && electron-builder --mac dmg --x64 && pnpm run dist:prune",
    "electron:dist:win:x64": "pnpm run dist:clean && electron-builder --win nsis --x64 && pnpm run dist:prune",
    "electron:release": "node scripts/verify-release.mjs && pnpm run dist:clean && electron-builder --publish always && pnpm run dist:prune"
  },
  "build": {
    "appId": "kr.mindex.app",
    "productName": "Mindex",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "min-dex",
        "repo": "min-dex.github.io",
        "releaseType": "release"
      }
    ],
    "files": [
      "index.html",
      "app.js",
      "mindex.worship-week.js",
      "mindex.monitor.js",
      "mindex.db-refresh.js",
      "mindex.constants.js",
      "mindex.design-tokens.js",
      "mindex.presenter.js",
      "mindex.worship-input.js",
      "mindex.presenter-ui.js",
      "mindex.setlist-links.js",
      "mindex.worship-atomic-client.mjs",
      "mindex.worship-store.mjs",
      "styles*.css",
      "favicon.ico",
      "manifest.webmanifest",
      "assets/**/*",
      "vendor/**/*",
      "electron/**/*",
      "package.json",
      "!dist/**/*",
      "!backups/**/*",
      "!tmp/**/*",
      "!tests/**/*",
      "!docs/**/*",
      "!scripts/**/*",
      "!data/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "fs-extra": "^11.3.6",
    "graceful-fs": "^4.2.11",
    "jsonfile": "^6.2.1",
    "universalify": "^2.0.1"
  }
}
